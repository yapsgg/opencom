# Required: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any OpenRouter model id. Haiku is fast and cheap for support chat.
OPENCOM_MODEL=anthropic/claude-haiku-5.5
# Used by `npm run analyze`.
OPENCOM_ANALYZE_MODEL=anthropic/claude-sonnet-5.5

# Who the agent is and where it lives.
OPENCOM_NAME=Assistant
OPENCOM_SITE_NAME=Acme
OPENCOM_SITE_URL=https://example.com
OPENCOM_GREETING=Hi! Ask me anything about Acme.
# Quote it: an unquoted # starts a comment in .env files.
OPENCOM_COLOR="#111111"
# Optional extra rules for the agent, e.g. tone or what to push.
OPENCOM_INSTRUCTIONS=

# What the agent answers from: comma-separated URLs (an llms.txt is ideal)
# plus any .md/.txt files in OPENCOM_KNOWLEDGE_DIR.
OPENCOM_KNOWLEDGE_URLS=https://example.com/llms.txt
OPENCOM_KNOWLEDGE_DIR=knowledge

# Chats are stored here. A local file by default; use a Turso URL
# (libsql://…) plus DATABASE_AUTH_TOKEN on hosts without a persistent disk.
DATABASE_URL=file:data/opencom.db
DATABASE_AUTH_TOKEN=

# Comma-separated origins allowed to embed the widget. Empty allows any.
OPENCOM_ALLOWED_ORIGINS=https://example.com,http://localhost:3000
# Protects GET /api/admin/conversations. Generate with: openssl rand -hex 32
OPENCOM_ADMIN_TOKEN=

PORT=8787
